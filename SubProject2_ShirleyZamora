#include <iostream>
#include <string>
#include <cstdlib>
#include <ctime>

using namespace std;

// TestAndSet: returns old value and sets lock to 1
int TestAndSet(int &lock) {
    int oldValue = lock;
    lock = 1;
    return oldValue;
}

// Locks: 0 = unlocked, 1 = locked
int readerCountLock = 0;
int resourceAccessLock = 0;

// Counters
int read_count = 0;
int activeReaders = 0;
int activeWriters = 0;

// Per-process state (3 readers, 2 writers)
int readerPC[3] = {0, 0, 0};
int writerPC[2] = {0, 0};
bool readerInCS[3] = {false, false, false};
bool writerInCS[2] = {false, false};
bool readerCompleted[3] = {false, false, false};
bool writerCompleted[2] = {false, false};

bool panicDetected = false;

void panicMessage(const string &message) {
    cout << "\nPANIC: " << message << "\n";
    panicDetected = true;
}

// Check synchronization rules
void checkSync() {
    if (activeReaders < 0 || activeReaders > 2)
        return panicMessage("Invalid number of active readers");
    if (activeWriters < 0 || activeWriters > 1)
        return panicMessage("Invalid number of active writers");
    if (activeReaders > 0 && activeWriters > 0)
        return panicMessage("Readers and writers are in the CS simultaneously");
    if (read_count < 0 || read_count > 2)
        return panicMessage("Invalid read_count");
    if (read_count != activeReaders)
        return panicMessage("read_count does not match activeReaders");
    if (readerCountLock < 0 || readerCountLock > 1)
        return panicMessage("Invalid readerCountLock");
    if (resourceAccessLock < 0 || resourceAccessLock > 1)
        return panicMessage("Invalid resourceAccessLock");

    int r = 0, w = 0;
    for (int i = 0; i < 3; i++) if (readerInCS[i]) r++;
    for (int i = 0; i < 2; i++) if (writerInCS[i]) w++;

    if (r != activeReaders)
        return panicMessage("Reader status does not match activeReaders");
    if (w != activeWriters)
        return panicMessage("Writer status does not match activeWriters");
    if ((activeReaders > 0 || activeWriters > 0) && resourceAccessLock == 0)
        return panicMessage("A process is in the CS without resourceAccessLock");
}

// R1 PROCESS
void R1() {
    switch (readerPC[0]) {
        case 0:
            cout << "I'm R1 in the entry and there are "
                 << activeReaders << " readers and " << activeWriters << " writers.\n";
            if (TestAndSet(readerCountLock) == 0) readerPC[0] = 1;
            break;

        case 1:
            if (read_count >= 2) { readerCountLock = 0; readerPC[0] = 0; }
            else if (read_count == 0) readerPC[0] = 2;
            else readerPC[0] = 3;
            break;

        case 2:
            if (TestAndSet(resourceAccessLock) == 0) readerPC[0] = 3;
            else { readerCountLock = 0; readerPC[0] = 0; }
            break;

        case 3:
            read_count++;
            activeReaders++;
            readerInCS[0] = true;
            cout << "I'm R1 in the CS and there are " << activeReaders - 1
                 << " other readers and " << activeWriters << " other writers.\n";
            readerPC[0] = 4;
            break;

        case 4:
            readerCountLock = 0;
            readerPC[0] = 5;
            break;

        case 5:
            readerPC[0] = 6;   // reading the shared data
            break;

        case 6:
            if (TestAndSet(readerCountLock) == 0) readerPC[0] = 7;
            break;

        case 7:
            read_count--;
            activeReaders--;
            readerInCS[0] = false;
            cout << "I'm R1 leaving the CS. There are "
                 << activeReaders << " readers remaining.\n";
            readerPC[0] = (read_count == 0) ? 8 : 9;
            break;

        case 8:
            resourceAccessLock = 0;
            readerPC[0] = 9;
            break;

        case 9:
            readerCountLock = 0;
            readerPC[0] = 10;
            break;

        case 10:
            readerCompleted[0] = true;
            readerPC[0] = 11;
            break;
    }
    checkSync();
}

