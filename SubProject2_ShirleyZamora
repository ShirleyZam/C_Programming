// Check whether all processes finished
bool allFinished() {

    for (int i = 0; i < 3; i++) {
        if (!readerCompleted[i]) {
            return false;
        }
    }

    for (int i = 0; i < 2; i++) {
        if (!writerCompleted[i]) {
            return false;
        }
    }

    return true;
}


// MAIN
int main() {

    srand(static_cast<unsigned int>(time(0)));

    cout << "Readers: 3\n";
    cout << "Writers: 2\n";
    cout << "readerCountLock = 0\n";
    cout << "resourceAccessLock = 0\n";

    int turn = 1;

    while (!allFinished() && !panicDetected) {

        int available[5];
        int count = 0;

        // Add unfinished readers
        for (int i = 0; i < 3; i++) {
            if (!readerCompleted[i]) {
                available[count++] = i;
            }
        }

        // Add unfinished writers
        for (int i = 0; i < 2; i++) {
            if (!writerCompleted[i]) {
                available[count++] = i + 3;
            }
        }

        if (count == 0) {
            break;
        }

        // Randomly select one process
        int selected = available[rand() % count];

        cout << "\nTurn " << turn << ": ";

        // Execute one process instruction
        switch (selected) {

            case 0:
                cout << "R1\n";
                R1();
                break;

            case 1:
                cout << "R2\n";
                R2();
                break;

            case 2:
                cout << "R3\n";
                R3();
                break;

            case 3:
                cout << "W1\n";
                W1();
                break;

            case 4:
                cout << "W2\n";
                W2();
                break;
        }

        turn++;

        if (panicDetected) {
            cout << "\nSimulation stopped because of a panic.\n";
            break;
        }
    }


    // Final results
    cout << "\nFinal read_count: " << read_count << "\n";
    cout << "Final activeReaders: " << activeReaders << "\n";
    cout << "Final activeWriters: " << activeWriters << "\n";
    cout << "Final readerCountLock: " << readerCountLock << "\n";
    cout << "Final resourceAccessLock: " << resourceAccessLock << "\n";

    if (!panicDetected && allFinished()) {
        cout << "\nAll five processes completed.\n";
        cout << "No synchronization errors detected.\n";
    }

    return 0;
}
