#include <iostream>
#include <string>
#include <cstdlib>
#include <ctime>

using namespace std;

// TestAndSet function
int TestAndSet(int &lock) {
    int oldValue = lock;
    lock = 1;
    return oldValue;
}

// Locks: 0 = unlocked, 1 = locked
int readerCountLock = 0;
int resourceAccessLock = 0;

// Counters
int read_count = 0;
int activeReaders = 0;
int activeWriters = 0;

// Separate program counters
int readerPC[3] = {0, 0, 0};
int writerPC[2] = {0, 0};

// Critical section status
bool readerInCS[3] = {false, false, false};
bool writerInCS[2] = {false, false};

// Completion status
bool readerCompleted[3] = {false, false, false};
bool writerCompleted[2] = {false, false};

bool panicDetected = false;


// Panic message
void panicMessage(const string &message) {
    cout << "\nPANIC: " << message << "\n";
    panicDetected = true;
}


// Check synchronization rules
void checkSync() {

    if (activeReaders < 0 || activeReaders > 2) {
        panicMessage("Invalid number of active readers");
        return;
    }

    if (activeWriters < 0 || activeWriters > 1) {
        panicMessage("Invalid number of active writers");
        return;
    }

    if (activeReaders > 0 && activeWriters > 0) {
        panicMessage("Readers and writers are in the CS simultaneously");
        return;
    }

    if (read_count < 0 || read_count > 2) {
        panicMessage("Invalid read_count");
        return;
    }

    if (read_count != activeReaders) {
        panicMessage("read_count does not match activeReaders");
        return;
    }

    if (readerCountLock < 0 || readerCountLock > 1) {
        panicMessage("Invalid readerCountLock");
        return;
    }

    if (resourceAccessLock < 0 || resourceAccessLock > 1) {
        panicMessage("Invalid resourceAccessLock");
        return;
    }

    int readerStatusCount = 0;
    int writerStatusCount = 0;

    for (int i = 0; i < 3; i++) {
        if (readerInCS[i]) {
            readerStatusCount++;
        }
    }

    for (int i = 0; i < 2; i++) {
        if (writerInCS[i]) {
            writerStatusCount++;
        }
    }

    if (readerStatusCount != activeReaders) {
        panicMessage("Reader status does not match activeReaders");
        return;
    }

    if (writerStatusCount != activeWriters) {
        panicMessage("Writer status does not match activeWriters");
        return;
    }

    if ((activeReaders > 0 || activeWriters > 0)
        && resourceAccessLock == 0) {
        panicMessage("A process is in the CS without resourceAccessLock");
        return;
    }
}


// R1 PROCESS
void R1() {

    switch (readerPC[0]) {

        case 0:
            cout << "I'm R1 in the entry and there are "
                 << activeReaders << " readers and "
                 << activeWriters << " writers.\n";

            if (TestAndSet(readerCountLock) == 0) {
                cout << "R1 acquired readerCountLock.\n";
                readerPC[0] = 1;
            } else {
                cout << "R1 is waiting for readerCountLock.\n";
            }
            break;

        case 1:
            if (read_count >= 2) {
                cout << "R1 is waiting because 2 readers are already inside.\n";
                readerCountLock = 0;
                cout << "R1 released readerCountLock.\n";
                readerPC[0] = 0;
            } else if (read_count == 0) {
                cout << "R1 is the first reader and must acquire resourceAccessLock.\n";
                readerPC[0] = 2;
            } else {
                cout << "R1 is joining the existing readers.\n";
                readerPC[0] = 3;
            }
            break;

        case 2:
            if (TestAndSet(resourceAccessLock) == 0) {
                cout << "R1 acquired resourceAccessLock.\n";
                readerPC[0] = 3;
            } else {
                cout << "R1 is waiting because a writer is inside the CS.\n";
                readerCountLock = 0;
                cout << "R1 released readerCountLock.\n";
                readerPC[0] = 0;
            }
            break;

        case 3:
            read_count++;
            activeReaders++;
            readerInCS[0] = true;

            cout << "I'm R1 in the CS and there are "
                 << activeReaders - 1 << " other readers and "
                 << activeWriters << " other writers.\n";

            cout << "R1 increased read_count to " << read_count << ".\n";

            readerPC[0] = 4;
            break;

        case 4:
            readerCountLock = 0;
            cout << "R1 released readerCountLock.\n";
            readerPC[0] = 5;
            break;

        case 5:
            cout << "R1 is reading the shared data buffer.\n";
            readerPC[0] = 6;
            break;

        case 6:
            if (TestAndSet(readerCountLock) == 0) {
                cout << "R1 acquired readerCountLock to leave.\n";
                readerPC[0] = 7;
            } else {
                cout << "R1 is waiting for readerCountLock to leave.\n";
            }
            break;

        case 7:
            read_count--;
            activeReaders--;
            readerInCS[0] = false;

            cout << "I'm R1 leaving the CS. There are "
                 << activeReaders << " readers remaining.\n";

            cout << "read_count is now " << read_count << ".\n";

            if (read_count == 0) {
                readerPC[0] = 8;
            } else {
                readerPC[0] = 9;
            }
            break;

        case 8:
            resourceAccessLock = 0;
            cout << "R1 released resourceAccessLock.\n";
            readerPC[0] = 9;
            break;

        case 9:
            readerCountLock = 0;
            cout << "R1 released readerCountLock.\n";
            readerPC[0] = 10;
            break;

        case 10:
            readerCompleted[0] = true;
            cout << "R1 has finished.\n";
            readerPC[0] = 11;
            break;
    }

    checkSync();
}


